<!DOCTYPE html>
<html lang="pt-br">
<head>
  <%- include("../partials/head") %>
  <%- include("../partials/menu") %>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Detalhe da Campanha</title>
</head>

<body>

<h1><%= campanha.titulo %></h1>

<p><strong>Conteúdo:</strong> <%= campanha.conteudo %></p>

<p>
  <strong>Início:</strong>
  <%= new Date(campanha.data_inicio * 1000).toLocaleDateString() %>
</p>

<p>
  <strong>Término:</strong>
  <%= new Date(campanha.data_termino * 1000).toLocaleDateString() %>
</p>

<p><strong>Dias restantes:</strong> <%= campanha.diasFaltando %></p>

<br>
<a href="/campanhas_ativas">← Voltar</a>

<%- include("../partials/footer") %>
</body>
</html>

<!DOCTYPE html>
<html lang="pt-br">
<%- include("../partials/head") %>
<%- include("../partials/menu") %>
<center>
  <head>
    <meta charset="UTF-8">
    <title color="aliceblue">Criação de Campanhas</title>
  </head>

  <body>
    <br><br>
    <h1 class="h1arrec">Criação de Campanhas</h1>
    <br>
    <form action="/campanhas_ativas" method="post" class="envio" style="background-color: #d0bdf4">
      <label for="titulo">⠀Digite o Nome da Campanha⠀⠀⠀</label>
      <input type="text" name="titulo" id="titulo" style="width: 200px; resize: none;" placeholder="Digite o título da campanha">
      <br><br>&nbsp;
      <label for="conteudo">⠀Digite sobre do que se trata a campanha na caixa de texto abaixo⠀⠀⠀</label>&nbsp;<br>
      <textarea name="conteudo" id="conteudo" style="width: 200px;" placeholder="Digite o conteúdo da campanha" rows="7" cols="50"></textarea>
      <br><br>&nbsp;
      <button type="submit" class="novacamp">Enviar</button>
    </form>
</center>
<br><br>
<%- include("../partials/footer") %>
</body>

</html>
<!DOCTYPE html>
<html lang="pt-br">
<%- include("../partials/head") %>
<%- include("../partials/menu") %>
<center>
  <head>
    <meta charset="UTF-8">
    <title color="aliceblue">Criação de Arrecadações</title>
  </head>

  <body>
    <br><br>
    <h1 class="h1arrec">Criação de Arrecadação</h1>
    <br>
    <form action="/criacao_itens" method="post" class="envio" style="background-color: #d0bdf4">
      <label for="titulo-arrecadacao">⠀Digite o Nome da campanha</label>
      <input type="text" name="id_titulo-arrecadacao" id="id_titulo-arrecadacao" style="width: 200px; resize: none;" placeholder="Digite o título da campanha">
      <br><br>&nbsp;
      <label for="conteudo">Digite sobre do que se trata a campanha na caixa de texto abaixo⠀⠀⠀</label>&nbsp;<br><br>
     <center> <textarea name="conteudo" id="conteudo" style="width: 200px;" placeholder="Digite o conteúdo da campanha" rows="7" cols="50"></textarea></center>
      <br><br>&nbsp;
      <button type="submit" class="novacamp">Enviar</button>
    </form>
</center>
<br><br>
<%- include("../partials/footer") %>
</body>

</html>
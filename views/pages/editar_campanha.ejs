<!DOCTYPE html>
<html lang="pt-br">
<head>
    <%- include("../partials/head") %>
    <%- include("../partials/menu") %>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Editar Campanha</title>
</head>
<body>

    <h1>Editar Campanha</h1>

<form action="/editar_campanha/<%= campanha.id_Campanha %>" method="POST">

    <label>Título:</label>
    <input type="text" name="titulo" value="<%= campanha.titulo %>"><br><br>

    <label>Conteúdo:</label>
    <textarea name="conteudo"><%= campanha.conteudo %></textarea><br><br>

    <label>Data de Início:</label>
    <input type="date" name="data_inicio" value="<%= inicioFmt %>"><br><br>

    <label>Data de Término:</label>
    <input type="date" name="data_termino" value="<%= terminoFmt %>"><br><br>

    <button type="submit">Salvar Alterações</button>

</form>


    <%- include("../partials/footer") %>
</body>
</html>

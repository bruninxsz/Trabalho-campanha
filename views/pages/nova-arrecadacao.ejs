<!DOCTYPE html>
<html>
<%- include("../partials/head") %>
<%- include("../partials/menu") %>
<head>
    <title>Nova Arrecadação</title>
    <meta charset="UTF-8">
</head>
<body>
    <h2>Nova Arrecadação</h2>
    
    <form action="/nova-arrecadacao" method="POST">
        <div>
            <label>Selecione uma turma:</label><br>
            <select name="id_turma" required>
                <option value="">Escolha uma turma</option>
                <% turmas.forEach(function(turma) { %>
                <option value="<%= turma.id_turma %>">
                    <%= turma.sigla %> - <%= turma.docente %>
                </option>
                <% }); %>
            </select>
        </div>
        
        <br>
        
        <div>
            <label>Selecione o Item:</label><br>
            <select name="id_Item" required>
                <option value="">Escolha um item</option>
                <% if (pontuacoes && pontuacoes.length > 0) { %>
                    <% pontuacoes.forEach(function(item) { %>
                    <option value="<%= item.id %>">
                        <%= item.Descricao %> (<%= item.pontos %> pontos)
                    </option>
                    <% }); %>
                <% } else { %>
                    <option value="">Nenhum item cadastrado</option>
                <% } %>
            </select>
        </div>
        
        <br>
        
        <div>
            <label>Selecione a quantidade:</label><br>
            <input type="number" name="qtd" min="1" value="1" required>
        </div>
        
        <br>
        
        <button type="submit">Enviar</button>
    </form>
</body>
<%- include("../partials/footer") %>
</html>